new file mode 100644
index 0000000..bf5489b
--- /dev/null
+++ b/lib/services/taxi_app_access.dart
@@ -0,0 +1,65 @@
+import 'taxi_owner_client.dart';
+
+enum TaxiAppRole {
+  administrator,
+  baseAdmin,
+  operator,
+  owner,
+  ownerDriver,
+  driver,
+}
+
+class TaxiAppAccess {
+  final TaxiAppRole role;
+  final bool nativeAdministrator;
+  const TaxiAppAccess(this.role, {this.nativeAdministrator = false});
+  bool get ownsTaxi =>
+      role == TaxiAppRole.owner || role == TaxiAppRole.ownerDriver;
+  bool get personal => ownsTaxi || role == TaxiAppRole.driver;
+  bool get advanced => role != TaxiAppRole.driver;
+  String get label => switch (role) {
+    TaxiAppRole.administrator => 'Administrador',
+    TaxiAppRole.baseAdmin => 'Administrador de la base',
+    TaxiAppRole.operator => 'Operador de la base',
+    TaxiAppRole.owner => 'Propietario',
+    TaxiAppRole.ownerDriver => 'Dueño y conductor',
+    TaxiAppRole.driver => 'Conductor',
+  };
+  String get taxiLabel => ownsTaxi ? 'Mi taxi y choferes' : 'Mi taxi y turno';
+  static Future<TaxiAppAccess> load(
+    TaxiOwnerClient client, {
+    required bool administrator,
+  }) async {
+    final context = await client.call({'action': 'context'});
+    final raw = context['accessRole'];
+    final configure = context['canConfigure'];
+    if (configure is! bool) {
+      throw const TaxiOwnerException(
+        'No pudimos comprobar los permisos de tu cuenta.',
+      );
+    }
+    final role = switch (raw) {
+      'owner' => TaxiAppRole.owner,
+      'owner_driver' => TaxiAppRole.ownerDriver,
+      'driver' => TaxiAppRole.driver,
+      null =>
+        administrator && configure
+            ? TaxiAppRole.administrator
+            : configure
+            ? TaxiAppRole.baseAdmin
+            : TaxiAppRole.operator,
+      _ => throw const TaxiOwnerException(
+        'El rol de esta cuenta no está habilitado.',
+      ),
+    };
+    if (raw != null && (administrator || configure)) {
+      throw const TaxiOwnerException(
+        'Los permisos de la cuenta necesitan revisión de la base.',
+      );
+    }
+    return TaxiAppAccess(
+      role,
+      nativeAdministrator: administrator && role == TaxiAppRole.administrator,
+    );
+  }
+}
